{
    "name": "philiprehberger/interchange",
    "description": "Service contract for interoperable HTTP services: W3C Trace Context across HTTP and queue boundaries, Standard Webhooks signing, and pluggable signature schemes",
    "type": "library",
    "keywords": ["trace-context", "w3c", "standard-webhooks", "webhooks", "observability", "laravel"],
    "homepage": "https://github.com/philiprehberger/php-interchange",
    "license": "MIT",
    "authors": [
        {
            "name": "Philip Rehberger",
            "email": "me@philiprehberger.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "philiprehberger/php-webhook-signature": "1.2.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0",
        "phpstan/phpstan": "^1.12|^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "PhilipRehberger\\Interchange\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhilipRehberger\\Interchange\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PhilipRehberger\\Interchange\\InterchangeServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
